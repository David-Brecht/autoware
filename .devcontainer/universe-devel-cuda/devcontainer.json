{
  "name": "autoware:universe-devel-cuda",
  "build": {
    "context": "../..",
    "dockerfile": "../Dockerfile",
    "args": {
      "BASE_IMAGE": "ghcr.io/autowarefoundation/autoware:universe-devel-cuda-jazzy"
    }
  },
  "remoteUser": "aw",
  "hostRequirements": {
    "gpu": true
  },
  "runArgs": ["--net=host", "--privileged", "--gpus", "all"],
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/aw/autoware,type=bind,consistency=cached",
  "workspaceFolder": "/home/aw/autoware",
  "initializeCommand": "mkdir -p ${localEnv:HOME}/autoware_data",
  "mounts": [
    "source=${localEnv:HOME}/autoware_data,target=/home/aw/autoware_data,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "HOST_UID": "${localEnv:HOST_UID:1000}",
    "HOST_GID": "${localEnv:HOST_GID:1000}",
    "ROS_DOMAIN_ID": "${localEnv:ROS_DOMAIN_ID:0}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "redhat.vscode-yaml",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools-extension-pack"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
